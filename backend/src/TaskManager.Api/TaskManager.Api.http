@baseUrl = http://localhost:5109
@taskId = paste-an-id-from-the-create-response

### Create a task
POST {{baseUrl}}/api/tasks
Content-Type: application/json

{
  "title": "Learn minimal APIs",
  "description": "Build the task manager",
  "priority": "High",
  "dueDate": null
}

### Get all tasks
GET {{baseUrl}}/api/tasks

### Get one task
GET {{baseUrl}}/api/tasks/{{taskId}}

### Update details (allowed in any status)
PUT {{baseUrl}}/api/tasks/{{taskId}}
Content-Type: application/json

{
  "title": "Learn minimal APIs deeply",
  "description": "Endpoints, errors and tests",
  "priority": "Medium",
  "dueDate": null
}

### Start
POST {{baseUrl}}/api/tasks/{{taskId}}/start

### Complete
POST {{baseUrl}}/api/tasks/{{taskId}}/complete

### Reopen
POST {{baseUrl}}/api/tasks/{{taskId}}/reopen

### Delete
DELETE {{baseUrl}}/api/tasks/{{taskId}}

### Invalid title -> 400
POST {{baseUrl}}/api/tasks
Content-Type: application/json

{
  "title": "   ",
  "priority": "Low"
}
